---
import Base from '../layouts/Base.astro';
import ProgramCard from '../components/ProgramCard.astro';
import { byDeadline, generatedOn, longDate, programs, url } from '../lib/format.ts';
import { CATEGORIES } from '../lib/schema.ts';

const CATEGORY_TEXT: Record<string, [string, string]> = {
  コンテスト: ['探究・研究の発表の場', '研究や企画を応募・発表するコンテスト。応募の形や審査の流れで比べられます。'],
  大学プログラム: ['大学が開く高校生向けの機会', '公開講座から研究体験まで。対象と選考のあり・なしを載せています。'],
  インターン: ['企業・団体での職場体験', '高校生を受け入れている先だけを掲載。費用や期間も並べて比べられます。'],
  ボランティア: ['地域・NPO の活動', 'イベント運営から継続的な活動まで。費用や対象を確認できます。'],
  研究助成: ['自分の研究に使える助成', '研究費の支援が受けられるプログラムです。'],
};
const BLOCK_LABEL: Record<string, string> = { 全国: '全国から応募' };
const categories = CATEGORIES.map((c) => ({ c, n: programs.filter((p) => p.category === c).length })).filter((x) => x.n);
const blockCounts = new Map<string, number>();
for (const p of programs) if (p.regionBlock) blockCounts.set(p.regionBlock, (blockCounts.get(p.regionBlock) ?? 0) + 1);
const soon = programs.filter((p) => p.status === 'open').sort(byDeadline).slice(0, 6);
const quick = [
  ['block=オンライン', 'オンライン'],
  ['block=全国', '全国から応募できる'],
  ['depth=深入', 'じっくり取り組める'],
  ['q=無料', '無料'],
] as const;
---
<Base>
  <section class="hero">
    <p class="eyebrow">高校生のための 探究・体験 情報</p>
    <h1>コンテスト、大学のプログラム、<br class="wide" />インターン、ボランティアを、ひとつの場所で。</h1>
    <p class="lead">出典・費用・締切をそろえて掲載。自分で比べて選べます。</p>
    <form action={url('/search/')} method="get" class="search" role="search">
      <label for="q" class="visually-hidden">キーワード</label>
      <input id="q" name="q" type="search" placeholder="キーワード（例：探究、福祉、プログラミング）" />
      <button class="btn btn-primary" type="submit">さがす</button>
    </form>
    <div class="quick">
      <span>よく使う条件：</span>
      {quick.map(([qs, label]) => <a class="pill" href={url(`/search/?${qs}`)}>{label}</a>)}
    </div>
    <p class="meta">掲載 {programs.length} 件 ／ データ更新 {longDate(generatedOn)}</p>
  </section>

  <section class="section">
    <h2>種類からさがす</h2>
    <div class="grid">
      {categories.map(({ c, n }) => (
        <a class="card" href={url(`/search/?cat=${encodeURIComponent(c)}`)}>
          <span class={`tag cat-${c}`} style="align-self:flex-start">{c}　{n}件</span>
          <span class="card-title">{CATEGORY_TEXT[c]![0]}</span>
          <span class="desc">{CATEGORY_TEXT[c]![1]}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>地域からさがす</h2>
    <div class="blocks">
      {[...blockCounts].map(([b, n]) => (
        <a class="block" href={url(`/search/?block=${encodeURIComponent(b)}`)}>{BLOCK_LABEL[b] ?? b} <span>{n}</span></a>
      ))}
    </div>
  </section>

  {soon.length > 0 && (
    <section class="section">
      <div class="title-row">
        <h2>締切が近いもの</h2>
        <a class="more" href={url('/search/')}>すべて見る</a>
      </div>
      <div class="grid">{soon.map((p) => <ProgramCard program={p} compact />)}</div>
    </section>
  )}

  <section class="section">
    <div class="values">
      <h2>このサイトが大切にしていること</h2>
      <div class="grid">
        <div>
          <h3>出典と確認日を必ず載せる</h3>
          <p>すべての項目に、情報のもとへのリンクと確認した日付を付けています。「公式で確認」「二次情報で確認」の区別も表示します。</p>
        </div>
        <div>
          <h3>書かれていないことは推測しない</h3>
          <p>費用や対象など、確認できなかった項目は「記載なし」と書きます。費用・宿泊・現地参加があるものは、公式の情報で確認したものだけを載せます。</p>
        </div>
        <div>
          <h3>終わった募集も「次の参考」に</h3>
          <p>募集が終わったものも、前回の情報として残します。次の募集の時期を見通すのに使えます。</p>
        </div>
      </div>
      <a class="more" href={url('/about/')}>掲載の基準を詳しく見る</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 64px var(--gutter) 48px; display: flex; flex-direction: column; gap: 22px; background: var(--accent-soft);
    /* 背景だけ画面いっぱいに広げる（中身は本文の幅のまま） */
    box-shadow: 0 0 0 100vmax var(--accent-soft); clip-path: inset(0 -100vmax);
  }
  .eyebrow { font-size: 14px; font-weight: 700; color: var(--accent); letter-spacing: 0.08em; }
  h1 { font-size: 40px; line-height: 1.4; max-width: 800px; text-wrap: balance; word-break: auto-phrase; }
  .lead { font-size: 17px; line-height: 1.8; color: #3a4558; }
  @media (max-width: 720px) {
    .hero { padding-block: 36px 32px; gap: 16px; }
    h1 { font-size: 24px; }
    .wide { display: none; }
    .lead { font-size: 15px; }
  }
  .search { display: flex; flex-wrap: wrap; gap: 12px; max-width: 760px; }
  .search input {
    flex: 1 1 280px; min-height: 52px; padding: 0 18px; font-size: 16px;
    border: 1px solid var(--line-input); border-radius: 10px; background: var(--surface);
  }
  .search .btn { min-height: 52px; padding: 0 32px; font-size: 16px; }
  @media (max-width: 720px) { .search .btn { flex: 1 1 100%; } }
  .quick { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: 14px; color: #3a4558; }
  .pill { background: var(--surface); border: 1px solid var(--line-2); border-radius: 999px; padding: 8px 16px; }
  .meta { font-size: 14px; color: var(--muted); }
  .card-title { font-size: 17px; font-weight: 700; }
  .desc { font-size: 14px; line-height: 1.7; color: var(--muted); }
  .blocks { display: flex; flex-wrap: wrap; gap: 12px; }
  .block {
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
    padding: 14px 22px; font-size: 15px; font-weight: 700;
  }
  .block span { font-weight: 500; color: var(--muted); margin-left: 4px; }
  .title-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
  .title-row h2 { font-size: 24px; }
  @media (max-width: 720px) { .title-row h2 { font-size: 20px; } }
  .more { font-size: 14px; font-weight: 500; color: var(--accent); }
  .values {
    background: var(--surface); border: 1px solid var(--line); border-radius: 16px;
    padding: 36px; display: flex; flex-direction: column; gap: 24px;
  }
  @media (max-width: 720px) { .values { padding: 22px; } }
  .values h2 { font-size: 22px; }
  .values .grid { gap: 28px; }
  .values h3 { font-size: 17px; margin-bottom: 8px; }
  .values p { font-size: 14px; line-height: 1.8; color: var(--muted); }
</style>
