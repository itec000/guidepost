---
// 一覧のカード。data-* は検索ページの絞り込み・並び替えで使う
import type { Program } from '../lib/schema.ts';
import { deadlineLabel, slashDate, url } from '../lib/format.ts';

interface Props {
  program: Program;
  compact?: boolean; // トップ・似ている項目用（費用や確認情報を省く）
  order?: number; // 検索ページの「締切が近い順」の並び
}
const { program: p, compact = false, order } = Astro.props;
const dl = deadlineLabel(p);
// 費用は長い説明が多いので、カードでは最初の文だけ
const cost = p.cost.split(/[。（(]/)[0]!.trim();
const keywords = [p.name, p.organizer, p.target, p.area, p.region, p.cost, p.category, ...p.tags].join(' ');
---
<a
  class="card program-card"
  href={url(`/programs/${p.id}/`)}
  data-category={p.category}
  data-tags={p.tags.join('|')}
  data-grades={p.grades.join('|')}
  data-block={p.regionBlock ?? ''}
  data-depth={p.depth}
  data-status={p.status}
  data-deadline={p.deadline ?? ''}
  data-checked={p.lastChecked ?? ''}
  data-keywords={keywords}
  data-order={order}
>
  <div class="row">
    <span class={`tag cat-${p.category}`}>{p.category}</span>
    <span class={`deadline is-${dl.tone}`}>{dl.text}</span>
  </div>
  <span class="card-title">{p.name}</span>
  <span class="org">{p.organizer}</span>
  {!compact && (
    <>
      <div class="facts">
        <span class="tag tag-outline">{p.region}</span>
        {cost && <span class="tag tag-outline">{cost}</span>}
        <span class={`tag depth-${p.depth}`}>体験の形：{p.depth}</span>
      </div>
      <div class="row foot">
        <span class="badges">
          <span class={`tag confirm-${p.confirm}`}>{p.confirm}</span>
          {p.needsRecheck && <span class="tag recheck">要再確認</span>}
        </span>
        {p.lastChecked && <span class="checked">最終確認 {slashDate(p.lastChecked)}</span>}
      </div>
    </>
  )}
</a>

<style>
  .program-card[data-status='closed'] { opacity: 0.78; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .card-title { font-size: 17px; font-weight: 700; line-height: 1.5; }
  .org { font-size: 14px; color: var(--muted); }
  .facts { display: flex; flex-wrap: wrap; gap: 8px; }
  .facts .tag { white-space: normal; font-size: 13px; }
  .foot { margin-top: auto; flex-wrap: wrap; }
  .badges { display: flex; gap: 6px; flex-wrap: wrap; }
  .checked { font-size: 12px; color: var(--muted-2); }
</style>
